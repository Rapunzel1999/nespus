# Store hosted values as Sites runtime secrets; never in hosting.json or Git.
# Identity comes only from the trusted SIWC gateway.
MODERATOR_EMAILS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# These must remain disabled until a specific paid SMS test budget is authorized.
TWILIO_VERIFY_ENABLED=false
# Cumulative send-attempt ceiling (not currency); 0 disables, supported pilot range 1..100.
# Increasing it authorizes additional sends only after owner approval. Never reset its DB counter.
TWILIO_VERIFY_TOTAL_SEND_LIMIT=0
